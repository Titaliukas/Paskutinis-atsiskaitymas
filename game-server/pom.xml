<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>lt.ktu.paskutinisatsiskaitymas</groupId>
    <artifactId>paskutinis-atsiskaitymas</artifactId>
    <version>1.0.0-SNAPSHOT</version>
  </parent>
  <artifactId>game-server</artifactId>
  <properties>
    <forbidden.imports>^lt\.ktu\.paskutinisatsiskaitymas\.client(\.|$).*,^javax\.swing\..*,^java\.awt\..*</forbidden.imports>
  </properties>
  <dependencies>
    <dependency>
      <groupId>lt.ktu.paskutinisatsiskaitymas</groupId>
      <artifactId>game-application</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>lt.ktu.paskutinisatsiskaitymas</groupId>
      <artifactId>game-domain</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>lt.ktu.paskutinisatsiskaitymas</groupId>
      <artifactId>game-protocol</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.java-websocket</groupId>
      <artifactId>Java-WebSocket</artifactId>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-simple</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
  <build>
    <finalName>game-server</finalName>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>module-dependencies</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <bannedDependencies>
                  <excludes>
                    <exclude>lt.ktu.paskutinisatsiskaitymas:*</exclude>
                  </excludes>
                  <includes>
                    <include>lt.ktu.paskutinisatsiskaitymas:game-application</include>
                    <include>lt.ktu.paskutinisatsiskaitymas:game-domain</include>
                    <include>lt.ktu.paskutinisatsiskaitymas:game-protocol</include>
                  </includes>
                </bannedDependencies>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                    <exclude>module-info.class</exclude>
                    <exclude>META-INF/versions/*/module-info.class</exclude>
                  </excludes>
                </filter>
              </filters>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>lt.ktu.paskutinisatsiskaitymas.server.GameServerMain</mainClass>
                  <manifestEntries>
                    <Multi-Release>true</Multi-Release>
                  </manifestEntries>
                </transformer>
              </transformers>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
